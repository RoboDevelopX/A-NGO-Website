# Copy to .env (or run `make setup`, which fills in the secrets for you).
# Every value here is optional in development; production requires SECRET_KEY.

APP_ENV=development
# Long random string used to sign sessions and CSRF tokens. Required in production.
SECRET_KEY=
SITE_URL=http://localhost:8000
DATABASE_URL=sqlite:///data/akshar.db

# Email: outbox (writes .eml files to OUTBOX_DIR), console (logs), or smtp.
EMAIL_BACKEND=outbox
EMAIL_FROM=Akshar Foundation <no-reply@akshar.example.org>
OUTBOX_DIR=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Admin login. Generate a hash with `make admin-password`; plain-text passwords are not accepted.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Abuse protection for public forms (attempts per IP per window).
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_SECONDS=600
# Set true only behind a reverse proxy you control.
TRUST_PROXY_HEADERS=false

# ML feature flags (each has a non-ML fallback).
ML_RELATED_POSTS=true
ML_EVENT_MATCHING=true
ML_SPAM_FILTER=true
SPAM_THRESHOLD=0.8
SPAM_MODEL_PATH=data/spam_model.joblib
